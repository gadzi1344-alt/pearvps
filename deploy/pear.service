[Unit]
Description=Pear social network
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pear
Group=pear
WorkingDirectory=/opt/pear
EnvironmentFile=/etc/pear/pear.env
ExecStart=/usr/bin/node /opt/pear/server.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
